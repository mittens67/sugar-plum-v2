generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model profiles {
  id         String   @id @db.Uuid
  user_id    String   @unique @db.Uuid
  is_admin   Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model promotions {
  id           BigInt              @id @default(autoincrement())
  created_at   DateTime            @default(now()) @db.Timestamptz(6)
  deleted_at   DateTime?           @db.Timestamptz(6)
  title        String
  description  String?
  image_url    String?
  is_active    Boolean             @default(true)
  link         String?
  start_date   DateTime?           @db.Timestamptz(6)
  end_date     DateTime?           @db.Timestamptz(6)
  priority     Int                 @default(0)
  display_type promo_display_type? @default(SPLIT)
}

enum promo_display_type {
  SPLIT
  IMAGE_ONLY
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model flavor_options {
  id                      BigInt                    @id @default(autoincrement())
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  label                   String?
  product_flavour_options product_flavour_options[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model package_sizes {
  id                    BigInt                  @id @default(autoincrement())
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  label                 String?                 @unique
  value                 Float?
  unit                  package_unit?
  product_package_sizes product_package_sizes[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model product_flavour_options {
  id             BigInt         @id @default(autoincrement())
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  product_id     BigInt
  flavor_id      BigInt
  flavor_options flavor_options @relation(fields: [flavor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products       products       @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model product_package_sizes {
  id            BigInt        @id @default(autoincrement())
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  product_id    BigInt
  package_id    BigInt
  package_sizes package_sizes @relation(fields: [package_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products      products      @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model products {
  id                      BigInt                    @id @default(autoincrement())
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  deleted_at              DateTime?                 @db.Timestamptz(6)
  item_name               String?                   @default("")
  description             String?
  info                    String?
  base_price              BigInt?                   @default(0)
  avg_rating              Float?
  ratings                 BigInt?
  product_type            category?
  image_large             String?
  image_medium            String?
  image_small             String?
  product_flavour_options product_flavour_options[]
  product_package_sizes   product_package_sizes[]
}

/// This enum is commented in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
enum category {
  snack
  cake
  custom
  cupcake
  pastry
  teacake
  cookies
  brownie
}

/// This enum is commented in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
enum package_unit {
  piece
  kg
}
